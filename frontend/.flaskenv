#.flaskenv
# DEFAULT DEVELOPMENT CONFIG

# FLASK_ENV - Controls the flask environment
# Values: production, development

FLASK_ENV=development

# FLASK_RUN_HOST - Host IP that frontend binds to
# Default: localhost

FLASK_RUN_HOST=0.0.0.0

# FLASK_RUN_PORT - Frontend port
# Default: 5000

FLASK_RUN_PORT=8008

# FLASK_DEBUG - Enable debug mode
# Default: False

FLASK_DEBUG=True

# FLASK_RUN_EXTRA_FILES - Additional files watched by the reloader
