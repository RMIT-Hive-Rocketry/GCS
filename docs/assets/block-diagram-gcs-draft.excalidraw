      "isDeleted": false,
      "boundElements": [],
      "updated": 1756808608420,
      "link": null,
      "locked": false,
      "text": "Hosts a Websocket API\nserver that forwards\nlocal IPC data to web\nclients",
      "fontSize": 28,
