    {
      "id": "f9IUsCac-MO4uGhQU032C",
      "type": "text",
      "x": 1312.197711650536,
      "y": 2225.4706822919998,
      "width": 380.19126426299727,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNZ",
