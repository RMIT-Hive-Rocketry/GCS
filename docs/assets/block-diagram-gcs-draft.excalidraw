      "seed": 1311852965,
      "version": 1050,
      "versionNonce": 193417227,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756808728802,
      "link": null,
      "locked": false,
      "text": "*temporary project*\nEmulates a real pendant\nwith any other device.\nThis is how we used an\nF710 game controller to\nlaunch the rocket",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*temporary project*\nEmulates a real pendant with any other device. This is how we used an F710 game controller to launch the rocket",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "cI_ukWb8sI47XtGMv-sME",
      "type": "text",
      "x": 2311.72011977359,
      "y": 843.6689801597015,
      "width": 380.19126426299727,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNa",
      "roundness": null,
      "seed": 1099443499,
      "version": 662,
      "versionNonce": 2052995924,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "7buVwOXYtxnNOrBr0-2Zh",
          "type": "arrow"
        },
        {
          "id": "yuXhYkPI6Lv189PgvhgxY",
          "type": "arrow"
        }
      ],
      "updated": 1756855816795,
      "link": null,
      "locked": false,
      "text": "The main server file\nOpens and reads Unix\nserial devices (radios)\nto listen for incoming\npackets. Then all\npackets are compiled\nwith Protobuf and sent\nover IPC  ",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The main server file\nOpens and reads Unix serial devices (radios) to listen for incoming packets. Then all packets are compiled with Protobuf and sent over IPC  ",
      "autoResize": false,
      "lineHeight": 1.25
    },
