      "versionNonce": 1002671435,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756808524313,
      "link": null,
      "locked": false,
      "text": "Creates a fake unix\nserial device that is a\n1-1 serial emulation of\nthe input we get from a\nradio device.  ",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Creates a fake unix serial device that is a 1-1 serial emulation of the input we get from a radio device.  ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "7KChbymjjJrtV2OncChMk",
