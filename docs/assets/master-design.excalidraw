      "updated": 1741604052679,
      "link": null,
      "locked": false,
      "text": "Note that a race condition cannot\nexist if this control flow is\nfollowed. You must not write to\nLoRa if waiting for GSE. And you\nare only waiting after you send a\nmessage. Only lock after you have\nsent a message.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note that a race condition cannot exist if this control flow is followed. You must not write to LoRa if waiting for GSE. And you are only waiting after you send a message. Only lock after you have sent a message.",
      "autoResize": false,
      "lineHeight": 1.25
    },
